						<!-- They are already persecuted, and are willing to get any help they could -->
						<relation faction="scavenger" otherfaction="player" relation="-0.0032"/>

						<!-- Some fellow pirates like the Scale Plate Pact, they will not attack you on sight, but maybe rob you -->
						<relation faction="buccaneers" otherfaction="player" relation="-0.0032"/>

						<!-- They see the good in anybody, but don't trust anyone too quickly -->
						<relation faction="boron" otherfaction="player" relation="-0.0032"/>

						<!-- They look at you with suspicion, trying not to be some dumb racists -->
						<relation faction="paranid" otherfaction="player" relation="-0.01"/>
						<relation faction="freesplit" otherfaction="player" relation="-0.01"/>
						<relation faction="holyorder" otherfaction="player" relation="-0.01"/>
						<relation faction="teladi" otherfaction="player" relation="-0.01"/>
						<relation faction="argon" otherfaction="player" relation="-0.01"/>
						<relation faction="antigone" otherfaction="player" relation="-0.01"/>
						<relation faction="player" otherfaction="fallensplit" relation="-0.01"/>
						<relation faction="player" otherfaction="hatikvah" relation="-0.01"/>

						<!-- They simply don't trust anyone worth trading with -->
						<relation faction="ministry" otherfaction="player" relation="-0.032"/>

						<!-- They don't like anyone, especially some wanna be cyborg pirate -->
						<relation faction="split" otherfaction="player" relation="-0.1"/>

						<!-- Your ennemy, unless you convince them otherwise -->
						<relation faction="terran" otherfaction="player" relation="-0.1"/>

						<!-- Your only "allies", exiled like you by the Terrans -->
						<relation faction="pioneers" otherfaction="player" relation="0.0032"/>

						<!-- Some sentient androides, maybe they will understand you -->
						<relation faction="kaori" otherfaction="player" relation="0.0032"/>

						<!-- Other factions will have default relation, including :
							Alliance of the World, they aim to unite, so they are neutral
							Court of Curbs, since they will only exists if you help them to
							Realm of the Trinity, since it's also a story plot
							Scale Plate, already "passive" toward anyone, but ready to rob them
							Vigor Syndicate, they don't care who you are if they can scam you some credits
							Xenon and Kha'ak, of course, hostile...
						 -->
